#:kivy 2.0.0

# These base rules apply to existing dialogs as well as the desktop workspace.
# More specific machine-state and axis rules retain their semantic colors.
<Button>:
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_color: (0, 0, 0, 0) if hasattr(self, 'base_color') or hasattr(self, 'icon') else ((0.118, 0.149, 0.192, 1) if self.state == 'normal' else (0.16, 0.24, 0.30, 1))
    color: 0.91, 0.94, 0.98, 1
    disabled_color: 0.40, 0.48, 0.58, 1

<TextInput>:
    background_normal: ''
    background_active: ''
    background_color: 0.118, 0.149, 0.192, 1
    foreground_color: 0.91, 0.94, 0.98, 1
    cursor_color: 0.27, 0.80, 0.73, 1
    selection_color: 0.20, 0.49, 0.50, 0.6
    padding: dp(12), dp(10)

<Popup>:
    background: ''
    background_color: 0.083, 0.106, 0.141, 1
    separator_color: 0.27, 0.80, 0.73, 1
    separator_height: dp(1)
    title_size: sp(18)
    title_color: 0.91, 0.94, 0.98, 1

<SpinnerOption>:
    background_normal: ''
    background_color: 0.118, 0.149, 0.192, 1
    height: dp(38)

<Action>:
    # Actions draw their own rounded, state-aware surfaces.
    background_color: 0, 0, 0, 0

<TransparentButton>:
    background_color: 0, 0, 0, 0
    color: 0, 0, 0, 0
    disabled_color: 0, 0, 0, 0

<TransparentGrayButton>:
    background_color: 0, 0, 0, 0

<RoundButton>:
    background_color: 0, 0, 0, 0

<SmallRoundButton>:
    background_color: 0, 0, 0, 0
